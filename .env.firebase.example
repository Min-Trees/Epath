# Firebase

# Project ID for both the Firebase CLI and the Admin SDK. Also used by the
# Firebase Hosting/Firestore project alias in `.firebaserc`.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=epath-website
FIREBASE_ADMIN_PROJECT_ID=epath-website

# Web client SDK config (safe to ship to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAYUpyRzjGt-FH7bwsrD9JdTHNVil2KZAY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=epath-website.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=epath-website.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=886099813308
NEXT_PUBLIC_FIREBASE_APP_ID=1:886099813308:web:23471e3c09b7c8a4f4c1b9
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-BGMYY8VJSF

# Admin SDK service account. Generate the JSON key from
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. Then copy the three fields below. Keep the \n escapes in the
# private key; the runtime replaces them with real newlines.
FIREBASE_ADMIN_CLIENT_EMAIL=
# Example (paste your own key, keep the \n escapes):
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=